local conf=require"loadconf"
local openid=assert(conf.openid,"The openid table is missing in mako.conf")
local dio=assert(ba.openio"disk")

-- The reusable SSO module reports what happened. This example decides how to
-- report it: always to trace and, when Mako SMTP is configured, by email.
local sendmail=conf.log and conf.log.smtp and require"log".sendmail
local function notify(event)
   local msg=string.format("%s%s",event.message,event.expires and
                           " Expiration: "..event.expires or "")
   trace("Microsoft Entra credential event:",event.kind,msg)
   if sendmail then
      ba.thread.run(function()
         local action=event.kind == "credential-expiring" or
                      event.kind == "credential-expired" or
                      event.kind == "credential-invalid"
         local ok,err=sendmail{
            to=openid.notify_to,
            subject="Microsoft Entra credential: "..event.kind,
            body=msg..(action and
               "\n\nOpen the server login page to replace an invalid or expired secret." or "")
         }
         if not ok then trace("Credential notification email failed:",err) end
      end)
   end
end

-- Mako example storage. A copied embedded application can replace only this
-- section; ms-sso.lua has no filesystem or Mako dependency.
local lockDir=mako.dos2unix(os.getenv"LocalAppData" or os.getenv"TEMP" or
                            os.getenv"TMP" or "/tmp").."/.LOCK"
assert(dio:stat(lockDir) or dio:mkdir(lockDir),"Cannot create WebDAV lock directory: "..lockDir)
local _,platform=io:resourcetype()
if platform == "windows" then
   local drive,path=lockDir:match"(.)(.+)"
   if drive then
      dio=assert(ba.mkio(dio,drive))
      lockDir=path
   end
end

require"wfs"
local fs=assert(ba.create.wfs("fs",dio,lockDir))
local base=dir:baseuri()
app.ssoBase=base
local msSso=appreq"ms-sso"
app.sso=msSso.init(openid,{notify=notify})

local function authresp(env)
   if env.request:header"Sec-Fetch-Dest" == "document" then
      env.response:sendredirect(base)
      return
   end
   env.response:setstatus(401)
   env.response:setcontenttype"application/json"
   env.response:setheader("Cache-Control","no-store")
   env.response:write'{"err":"sessionexpired","emsg":"Your session has expired. Sign in again to continue."}'
end
local function notAuthenticated() end
local auth=ba.create.authenticator(
   ba.create.authuser(notAuthenticated),{type="auth",response=authresp})

dir:insert(fs,true)
fs:setauth(auth)
fs:configure{tmo=2*60*60,helpuri=base.."help.lsp",logouturi=base.."logout.lsp"}
trace("Installing Web File Server at:",base.."fs/")

function onunload()
   app.sso.close()
   fs:unlink()
end

-- Mako can provide this same table as sharkTrustExample in a private mako.conf.
local config=mako and require"loadconf".sharkTrustExample or {
   acceptTerms=false, -- Enable after accepting the ACME provider's terms.
   email="CHANGE-ME@example.com",
   domains={"CHANGE-ME.example.com"},
   production=false, -- Use staging until the complete flow works.
   keyType="ecc", -- For RSA, set keyType="rsa" and bits=2048.
   namePolicy="exact",
   challenge={
      type="dns-01",dns="local",reverse=false,propagationDelay=30,
      -- Leave these nil to use the embedded zone identity.
      -- Otherwise supply all three, including a host proof callback.
      portalUrl=nil,zoneKey=nil,proof=nil
   }
}

-- Mako uses its private home; a standalone BAS host supplies writable disk I/O.
local persistentIo=assert(ba.openio(mako and "home" or "disk"),
   "Cannot open the writable I/O")

local httpsListener

-- Runtime calls this function with the complete active certificate set.
-- The first call opens HTTPS port 9443. Later calls recycle the listener so
-- existing connections can finish while new connections use the new certificate.
local function installCertificates(records,callback)
   if not records[1] then
      if httpsListener then httpsListener:close() httpsListener=nil end
      callback(true,nil)
      return
   end

   local shark=assert(ba.create.sharkssl(nil,{server=true}),
      "Cannot create the SharkSSL server object")
   for _,record in ipairs(records) do
      local key=record.privateKey
      local sharkcert,certError
      if type(key) == "table" and key.provider == "tpm" then
         -- Restore the named ECC key before installation after a restart.
         local tpm=assert(ba.tpm,"TPM certificate installer unavailable")
         if not tpm.haskey(key.name) then tpm.createkey(key.name,key.options) end
         sharkcert,certError=tpm.sharkcert(key.name,record.certificate)
      else
         sharkcert,certError=ba.create.sharkcert(record.certificate,key)
      end
      assert(sharkcert,certError or "Cannot create the SharkSSL certificate")
      shark:addcert(sharkcert)
   end

   local listener,listenError=ba.create.servcon(httpsListener or 9443,{shark=shark})
   assert(listener,listenError or "Cannot open HTTPS port 9443")
   httpsListener=listener
   callback(true,nil)
end

local runtime,err=require"acme/runtime".create{
   config=config,
   io=persistentIo,install=installCertificates,
   notify=function(code) trace("ACME event ",code) end
}
assert(runtime,err and (err.message or err.code))
runtime:start(function(result,problem)
   if result then trace("ACME certificate management started")
   else trace("ACME startup failed: ",problem.message or problem.code) end
end)

-- The application owns this runtime and releases it on unload.
function onunload()
   runtime:close()
   if httpsListener then httpsListener:close() httpsListener=nil end
end

-- Forward later DHCP/address changes without rebuilding the runtime:
-- runtime:setIpAddress(newIpAddress,function(ok,problem) end)
